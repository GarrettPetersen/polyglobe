{
  "name": "marque-and-reprisal",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-static-site.mjs",
    "build:demo": "node tools/build-static-site.mjs --edition=demo",
    "package:demo:itch": "npm run build:demo && node tools/package-itch-demo.mjs",
    "check": "node --check src/main.js && npm test && npm run build",
    "dev": "node server.mjs",
    "generate:characters": "node tools/build-character-portrait-manifest.mjs",
    "preview:character-expressions": "node tools/render-character-expression-review.mjs",
    "benchmark:busy": "node tools/run-performance-benchmark.mjs",
    "benchmark:combat": "node tools/run-performance-benchmark.mjs --benchmark combat-hotspot",
    "benchmark:busy:pi": "node tools/run-performance-benchmark.mjs --cpu-throttle 4",
    "capture:trailer": "node tools/capture-trailer-clips.mjs",
    "build:steam-trailer": "node tools/trailer/run-python-tool.mjs build-steam-trailer.py",
    "build:steam-inline-videos": "node tools/trailer/run-python-tool.mjs build-steam-inline-videos.py",
    "normalize:sfx": "node tools/normalize-sfx.mjs",
    "render:ship": "node tools/render-sail-ship-sprites.mjs",
    "render:whales": "node tools/render-sail-ship-sprites.mjs --whales",
    "render:horse-cart": "node tools/render-sail-ship-sprites.mjs --horse-cart",
    "render:all-ships": "node tools/render-sail-ship-sprites.mjs --all-production-ships",
    "render:rowing-ships": "node tools/render-sail-ship-sprites.mjs --rowing-ships",
    "render:native-boats": "node tools/render-sail-ship-sprites.mjs --native-boats",
    "render:mediterranean-galley": "node tools/render-sail-ship-sprites.mjs --mediterranean-galley",
    "render:joseon-turtle-ship": "node tools/render-sail-ship-sprites.mjs --joseon-turtle-ship",
    "render:joseon-panokseon": "node tools/render-sail-ship-sprites.mjs --joseon-panokseon",
    "render:japanese-atakebune": "node tools/render-sail-ship-sprites.mjs --japanese-atakebune",
    "render:spanish-nao": "node tools/render-sail-ship-sprites.mjs --spanish-nao",
    "render:portuguese-carrack": "node tools/render-sail-ship-sprites.mjs --portuguese-carrack",
    "render:dhow": "node tools/render-sail-ship-sprites.mjs --gogiart-dhow",
    "render:galleon": "node tools/render-sail-ship-sprites.mjs --cyc3w-galleon",
    "render:nusantaran-outrigger": "node tools/render-sail-ship-sprites.mjs --nusantaran-outrigger",
    "render:ottoman-coastal-trader": "node tools/render-sail-ship-sprites.mjs --ottoman-coastal-trader",
    "render:viking-longship": "node tools/render-sail-ship-sprites.mjs --viking-longship",
    "render:mediterranean-galley-reference": "PIXEL_GLOBE_SHIP_FRAME_SIZE=96 PIXEL_GLOBE_SHIP_RENDER_SIZE=192 PIXEL_GLOBE_SHIP_SHADOW_FRAME_SIZE=192 PIXEL_GLOBE_SHIP_PREVIEW_SCALE=1 node tools/render-sail-ship-sprites.mjs --mediterranean-galley-reference",
    "render:social-cards": "node tools/render-social-cards.mjs",
    "render:unity-ships": "node tools/render-sail-ship-sprites.mjs --unity-fleet",
    "render:unity-ship": "node tools/render-sail-ship-sprites.mjs --unity-ship",
    "render:unity-ship-side-views": "node tools/render-sail-ship-sprites.mjs --unity-fleet-side-views",
    "render:ship-waterline-review": "node tools/render-sail-ship-sprites.mjs --waterline-review",
    "render:faction-flags": "node tools/render-faction-flags.mjs",
    "render:ship-menu-icons": "node tools/build-ship-menu-icons.mjs",
    "render:game-icons": "npm run render:ship-menu-icons && node tools/build-game-icon-atlas.mjs",
    "render:port-sailing-distances": "node tools/build-port-sailing-distances.mjs",
    "render:fresh-water-cask": "node tools/build-fresh-water-cask-icon.mjs",
    "render:land-roads": "node tools/build-land-roads.mjs",
    "render:pixel-pirate-font": "node tools/fix-pixel-pirate-font-kerning.mjs",
    "render:capsules": "node tools/generate-layered-capsule-art.mjs",
    "render:capsule-title-comparison": "node tools/generate-capsule-title-comparison.mjs",
    "test": "node --test src/*.test.js",
    "test:characters": "node --test src/characterPortraits.test.js",
    "test:music": "node --test src/musicPlayer.test.js"
