  "group"
  {
    "id" "18"
    "mode" "joystick_move"
    "inputs" {}
    "gameactions" { "Menus" "scroll" }
  }
  "preset"
  {
    "id" "0"
    "name" "Sailing"
    "group_source_bindings"
    {
      "0" "button_diamond active"
      "1" "joystick active"
      "2" "dpad active"
      "3" "left_trigger active"
      "4" "right_trigger active"
      "5" "switch active"
      "6" "left_trackpad active"
    }
  }
  "preset"
  {
    "id" "1"
    "name" "Menus"
    "group_source_bindings"
    {
      "10" "button_diamond active"
      "11" "joystick active"
      "12" "dpad active"
      "13" "right_joystick active"
      "14" "left_trigger active"
