      "dpad_south" { "activators" { "Full_Press" { "bindings" { "binding" "game_action Menus navigate_down, Navigate down" } } } }
      "dpad_west" { "activators" { "Full_Press" { "bindings" { "binding" "game_action Menus navigate_left, Navigate left" } } } }
      "dpad_east" { "activators" { "Full_Press" { "bindings" { "binding" "game_action Menus navigate_right, Navigate right" } } } }
    }
