    }
  }
  "group"
  {
    "id" "15"
    "mode" "trigger"
    "inputs"
    {
      "edge" { "activators" { "Full_Press" { "bindings" { "binding" "game_action Menus next_page, Next page" } } } }
    }
  }
  "group"
  {
    "id" "16"
    "mode" "switches"
    "inputs"
    {
      "left_bumper" { "activators" { "Full_Press" { "bindings" { "binding" "game_action Menus previous_page, Previous page" } } } }
      "right_bumper" { "activators" { "Full_Press" { "bindings" { "binding" "game_action Menus next_page, Next page" } } } }
    }
  }
  "group"
  {
