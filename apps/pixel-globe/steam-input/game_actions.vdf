"Action Manifest"
{
  "configurations"
  {
    "controller_neptune" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_steamcontroller_gordon" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_xbox360" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_xboxone" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_xboxelite" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_ps3" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_ps4" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_ps5" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_ps5_edge" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_switch_pro" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_switch2_pro" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_switch_joycon_left" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_switch_joycon_right" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_switch_joycon_pair" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_mobile_touch" { "0" { "path" "standard_gamepad.vdf" } }
    "controller_generic" { "0" { "path" "standard_gamepad.vdf" } }
  }
  "actions"
  {
    "Sailing"
    {
      "title" "#Set_Sailing"
      "legacy_set" "0"
      "StickPadGyro"
      {
        "steer"
        {
          "title" "#Action_Steer"
          "input_mode" "joystick_move"
        }
      }
      "Button"
      {
        "steer_up" { "title" "#Action_SteerUp" }
        "steer_down" { "title" "#Action_SteerDown" }
        "steer_left" { "title" "#Action_SteerLeft" }
        "steer_right" { "title" "#Action_SteerRight" }
        "sailing_confirm" { "title" "#Action_Confirm" }
        "sailing_back" { "title" "#Action_Back" }
        "anchor" { "title" "#Action_Anchor" }
        "sailing_secondary" { "title" "#Action_Secondary" }
        "cycle_target" { "title" "#Action_CycleTarget" }
        "captain_menu" { "title" "#Action_CaptainMenu" }
        "fire_port" { "title" "#Action_FirePort" }
        "fire_starboard" { "title" "#Action_FireStarboard" }
      }
    }
    "Menus"
    {
      "title" "#Set_Menus"
      "legacy_set" "0"
      "StickPadGyro"
      {
        "navigate"
        {
          "title" "#Action_Navigate"
          "input_mode" "joystick_move"
        }
        "scroll"
        {
          "title" "#Action_Scroll"
          "input_mode" "joystick_move"
        }
      }
      "Button"
      {
        "navigate_up" { "title" "#Action_NavigateUp" }
        "navigate_down" { "title" "#Action_NavigateDown" }
        "navigate_left" { "title" "#Action_NavigateLeft" }
        "navigate_right" { "title" "#Action_NavigateRight" }
        "menu_confirm" { "title" "#Action_Confirm" }
        "menu_back" { "title" "#Action_Back" }
        "menu_secondary" { "title" "#Action_Secondary" }
        "previous_page" { "title" "#Action_PreviousPage" }
        "next_page" { "title" "#Action_NextPage" }
      }
    }
  }
  "localization"
  {
    "english"
    {
      "#Set_Sailing" "Sailing"
      "#Set_Menus" "Menus"
      "#Action_Steer" "Steer"
      "#Action_SteerUp" "Steer up"
      "#Action_SteerDown" "Steer down"
