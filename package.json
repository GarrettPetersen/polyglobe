{
  "name": "polyglobe",
  "version": "0.1.0",
  "description": "Reusable low-poly 3D globe with hexagons and pentagons, terrain, water, and placement tools",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "railways:dev": "npm --prefix apps/railways run dev",
    "railways:dev:host": "npm --prefix apps/railways run dev:host",
    "railways:dev:join": "npm --prefix apps/railways run dev:join",
    "railways:server": "npm --prefix apps/railways run server",
    "railways:build": "npm --prefix apps/railways run build",
    "railways:preview": "npm --prefix apps/railways run preview",
    "pixel-globe:dev": "npm --prefix apps/pixel-globe run dev",
    "pixel-globe:build": "npm --prefix apps/pixel-globe run build",
    "pixel-globe:build-demo": "npm --prefix apps/pixel-globe run build:demo",
    "pixel-globe:package-demo:itch": "npm --prefix apps/pixel-globe run package:demo:itch",
    "pixel-globe:steam-package": "npm --prefix apps/pixel-globe run steam:package",
    "pixel-globe:steam-package-full": "npm --prefix apps/pixel-globe run steam:package:full",
    "pixel-globe:steam-package-demo": "npm --prefix apps/pixel-globe run steam:package:demo",
    "pixel-globe:steam-package-mac-signed": "npm --prefix apps/pixel-globe run steam:package:mac:signed",
    "pixel-globe:steam-package-mac-release": "npm --prefix apps/pixel-globe run steam:package:mac:release",
    "pixel-globe:steam-prepare-upload": "npm --prefix apps/pixel-globe run steam:prepare-upload --",
    "pixel-globe:steam-upload": "npm --prefix apps/pixel-globe run steam:upload --",
    "pixel-globe:check": "npm --prefix apps/pixel-globe run check",
    "pixel-globe-telemetry:check": "npm --prefix apps/pixel-globe-telemetry run check",
    "pixel-globe-telemetry:deploy": "npm --prefix apps/pixel-globe-telemetry run deploy",
    "pixel-globe-telemetry:dashboard:configure": "npm --prefix apps/pixel-globe-telemetry run configure-dashboard",
    "pixel-globe-telemetry:dashboard:verify": "npm --prefix apps/pixel-globe-telemetry run verify-dashboard",
    "pixel-globe-telemetry:verify": "npm --prefix apps/pixel-globe-telemetry run verify",
    "pixel-globe-telemetry:report": "npm --prefix apps/pixel-globe-telemetry run report",
    "pixel-globe-telemetry:crashes": "npm --prefix apps/pixel-globe-telemetry run crashes --",
    "marque-site:dev": "npm --prefix apps/marque-and-reprisal-site run dev",
    "marque-site:build": "npm --prefix apps/marque-and-reprisal-site run build",
    "marque-site:check": "npm --prefix apps/marque-and-reprisal-site run check",
    "marque-site:deploy": "npm --prefix apps/marque-and-reprisal-site run deploy"
  },
  "keywords": [
    "three",
    "three.js",
    "globe",
    "low-poly",
    "hexagon",
    "geodesic",
    "terrain",
    "water",
    "planet"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "earcut": "^2.2.4",
    "polygon-clipping": "^0.15.7",
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/earcut": "^2.1.4",
    "@types/three": "^0.170.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": false
    }
  }
}
